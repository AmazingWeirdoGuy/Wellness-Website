{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] }
  },
  "include": [
    "src/App.tsx",
    "src/BurnEffect.tsx",
    "src/MindfulnessMinigames.tsx",
    "src/main.tsx",
    "src/components/error-boundary.tsx",
    "src/pages/not-found.tsx",
    "vite.config.ts"
  ],
  "exclude": ["src/components/ui", "src/hooks", "src/lib"]
}
